{
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "crons": [
    { "path": "/api/plan", "schedule": "1 3 * * *" },
    { "path": "/api/calendar-consistency", "schedule": "31 3 * * *" },
    { "path": "/api/business-invoicing", "schedule": "0 5 20 * *" },
    { "path": "/api/invoice-report", "schedule": "0 7 * * *" }
  ],
  "redirects": [
    { "source": "/p/faa-et-tilbud", "destination": "/#tilbudsmotor", "permanent": true },
    { "source": "/p/faa-et-tilbud/", "destination": "/#tilbudsmotor", "permanent": true },
    { "source": "/erhverv", "destination": "/p/erhverv", "permanent": false },
    { "source": "/erhverv/", "destination": "/p/erhverv", "permanent": false },
    { "source": "/c/det-vi-ordner/soignering-af-bede", "destination": "/p/det-vi-ordner", "permanent": true },
    { "source": "/c/det-vi-ordner/soignering-af-bede/", "destination": "/p/det-vi-ordner", "permanent": true },
    { "source": "/p/forside", "destination": "/", "permanent": true, "statusCode": 308 },
    { "source": "/p/forside/", "destination": "/", "permanent": true, "statusCode": 308 }
  ]
}
